# Copy to .env for local development. On Render, set these in
# Dashboard → your service → Environment instead — .env is gitignored
# and never reaches the server.

# ── DATABASE ──────────────────────────────────────────────────────────────────
# Local (MongoDB Compass default):
MONGO_URI=mongodb://127.0.0.1:27017/ciprms
#
# Atlas — paste the string from Atlas → Connect → Drivers, then:
#   1. replace <db_password> with the real password (URL-encode @ : / ? # % as
#      %40 %3A %2F %3F %23 %25)
#   2. leave the rest of the query string exactly as Atlas gave it
# MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0

# Atlas connection strings carry no database name, so set it explicitly.
# Must match the database you restored the Compass data into.
MONGO_DB_NAME=ciprms

# ── SESSIONS ──────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ── GOOGLE OAUTH ──────────────────────────────────────────────────────────────
# The OAuth callback URL is derived from the incoming request host at runtime,
# so there is nothing to set here — but the deployed URL
# (https://<your-service>.onrender.com/auth/google/callback) must be listed as an
# Authorized redirect URI in the Google Cloud console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GOOGLE_TOKEN_ENCRYPTION_KEY=

# ── RUNTIME ───────────────────────────────────────────────────────────────────
# Set NODE_ENV=production on Render — it enables secure session cookies and
# skips the dev-only browser auto-open.
NODE_ENV=development

# PORT is injected by Render automatically. Only set it locally if 3000 is taken.
# PORT=3000
